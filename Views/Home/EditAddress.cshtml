@using Microsoft.AspNetCore.Routing.Constraints
@using webbhelpuf.Data.Models;
@using webbhelpuf.Shared;
@model webbhelpuf.ViewModels.HomeViewModel;
@{
    ViewData["Title"] = "Home Page";
    ViewData["ShopTheme"] = Model.ShopTheme + ".css";
}
<h1>
  @if (Model.HasAddress)
  {
    <h1>Verifiera Adress</h1>
  }
  else
  {
    <h1>Registrera Adress</h1>
  }
</h1>

<div class="row">
  <div class="col-md-8 mb-4">
    <div class="card mb-4">
      <div class="card-header py-3">
        <h5 class="mb-0">Adressat</h5>
      </div>
      <div class="card-body">
        <form asp-controller="Home" asp-action="EditAddress">
          <input type="hidden" name="cartid" value="@Model.Cart.Id" />
            @if (Model.HasAddress)
            {
                <div class="row">
                    <div class="col">
                        <p class="alert alert-primary">
                            Försäkra dig om att adressuppgifterna är korrekta innan du klickar på köp-knappen
                        </p>
                    </div>
                </div>
            }
          <div class="row mb-4">
            <div class="col">
              <div data-mdb-input-init class="form-outline">
                <label class="form-label" for="formfirstname">Förnamn</label>
                @{string _form_firstname = Model.HasAddress ? Model.CustomerInfo.FirstName : string.Empty;}
                <input type="text" id="formfirstname" name="firstname" class="form-control" value="@_form_firstname" required />
              </div>
            </div>
            <div class="col">
              <div data-mdb-input-init class="form-outline">
                <label class="form-label" for="formlastname">Efternamn</label>
                @{string _form_lastname = Model.HasAddress ? Model.CustomerInfo.LastName : string.Empty;}
                <input type="text" id="formlastname" name="lastname" class="form-control" value="@_form_lastname" required />
              </div>
            </div>
          </div>

          <div class="row mb-4">
            <div class="col">
              <div data-mdb-input-init class="form-outline">
                <label class="form-label" for="formstreetname">Gatuadress</label>
                @{string _form_streetname = Model.HasAddress ? Model.CustomerInfo.StreetName : string.Empty;}
                <input type="text" id="formstreetname" name="streetname" class="form-control" value="@_form_streetname" required />
              </div>
            </div>
            <div class="col">
              <div data-mdb-input-init class="form-outline">
                <label class="form-label" for="formstreetno">Gatunummer</label>
                @{string _form_streetno = Model.HasAddress ? Model.CustomerInfo.StreetNo : string.Empty;}
                <input type="text" id="formstreetno" name="streetno" class="form-control" value="@_form_streetno" required />
              </div>
            </div>
          </div>

          <div class="row mb-4">
            <div class="col">
              <div data-mdb-input-init class="form-outline">
                <label class="form-label" for="formzipcode">Postnummer</label>
                @{string _form_zipcode = Model.HasAddress ? Model.CustomerInfo.StreetNo : string.Empty;}
                <input type="text" id="formzipcode" name="zipcode" class="form-control" value="@_form_zipcode" required />
              </div>
            </div>
            <div class="col">
              <div data-mdb-input-init class="form-outline">
                <label class="form-label" for="formcity">Stad</label>
                @{string _form_city = Model.HasAddress ? Model.CustomerInfo.City : string.Empty;}
                <input type="text" id="formcity" name="city" class="form-control" value="@_form_city" required />
              </div>
            </div>
          </div>

          <!-- Email input -->
          <div data-mdb-input-init class="form-outline mb-4">
            <label class="form-label" for="formemail">Epost</label>
            <input type="email" id="formemail" name="email" class="form-control" required />
          </div>

          <!-- Number input -->
          <div data-mdb-input-init class="form-outline mb-4">
            <label class="form-label" for="formphone">Telefonnummer</label>
            <input type="number" id="formphone" name="phone" class="form-control" />
          </div>

          <!-- Message input -->
          <div data-mdb-input-init class="form-outline mb-4">
            <label class="form-label" for="formaddinfo">Ytterligare information / önskemål</label>
            <textarea class="form-control" id="formaddinfo" name="addinfo" rows="4"></textarea>
          </div>

          <div>
            <input type="submit" class="btn btn-primary btn-lg btn-block" value="Registrera" />
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-4 mb-4">
    <div class="card mb-4">
      <div class="card-header py-3">
        <h5 class="mb-0">Sammanställning</h5>
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 pb-0">
            Produkter
            <span>12345.00 SEK</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            Frakt
            <span>100 SEK</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 mb-3">
            <div>
              <strong>Summa</strong>
              <strong>
                <p class="mb-0">(inklusive moms)</p>
              </strong>
            </div>
            <span><strong>12445.00 SEK</strong></span>
          </li>
        </ul>
        @if (Model.HasAddress)
        {
          <input type="submit" class="btn btn-primary btn-lg btn-block" value="Köp" />
        }
        else
        {
          <button class="btn btn-primary btn-lg btn-block"
                  data-bs-toggle="tooltip"
                  data-bs-placement="bottom"
                  title="Registrera din adress innan köp"
                  aria-disabled="true"
                  >
            Köp
          </button>
        }
      </div>
    </div>
  </div>
</div>