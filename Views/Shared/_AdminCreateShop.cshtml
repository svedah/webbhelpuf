<h2>Skapa Shop</h2>

<div class="alert alert-danger">EJ FÄRDIG!</div>

<fieldset class="form-group border p-3">
<legend class="w-auto">Inställningar</legend>
<form asp-controller="Admin" asp-action="CreateShop">

    @* UF-shoppens Titel *@
    <div class="form-group">
        <label for="a">
            Namn UF-shop
        </label>
        <input  id="a" 
                name="title" 
                type="text" 
                class="form-control" 
                value="" />
    </div>

    @* UF-shoppens Mobilnummer *@
    <div class="form-group">
        <label for="a">
            Mobilnummer
        </label>
        <input  id="a" 
                name="title" 
                type="text" 
                class="form-control" 
                value="" />
    </div>

    @* UF-shoppens e-post *@
    <div class="form-group">
        <label for="a">
            E-post
        </label>
        <input  id="a" 
                name="title" 
                type="email" 
                class="form-control" 
                value="" />
        </div>

    @* UF-shoppens Swishnummer *@
    <div class="form-group">
        <label for="a">
            Swishnummer
        </label>
        <input  id="a" 
                name="title" 
                type="text" 
                class="form-control" 
                value="" />
        </div>

</form>
