@model webbhelpuf.Data.Models.ShopItem
@{
    @* string link = @Model.ItemsAvailable == 0 ? "#" : "/Article/View/" + @Model.Id; *@
}

@* https://getbootstrap.com/docs/4.0/components/card/ card with footers *@
<div class="card shopitemwidth">
    <a class="linkinherit" href="/Home/Article/@Model.Id">
        <img class="card-img-top" src="/img/items/@Model.PrimaryImage.Filename" alt="@Model.PrimaryImage.AltText" />
        <div class="card-body">
            <h5 class="card-title">@Model.Title</h5>
            <p class="card-text">@Model.Description</p>
        </div>
        <div class="card-footer">
            <div>
                Antal: @Model.ItemsAvailable
            </div>
            <div>
                Pris: @Model.Price SEK
            </div>
        </div>
    </a>
</div>