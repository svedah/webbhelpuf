@using webbhelpuf.Data.Models
@model webbhelpuf.Data.Models.Cart

<div>
<h6>Varukorg</h6>

@if (Model.Items.Count > 0)
{
    <table>
        <tr>
            <th>Vara</th>
            <th>Antal</th>
            <th>Pris</th>
        </tr>
        @foreach(CartItem cartItem in Model.Items)
        {
            int price = cartItem.Amount * cartItem.ShopItem.Price;
            <tr>
                <td>
                    @cartItem.ShopItem.Title
                    <img src="/img/items/@cartItem.ShopItem.PrimaryImage.Filename" style="width:3rem;"/>
                </td>
                <td>
                    @cartItem.Amount
                </td>
                <td>
                    @price
                </td>
            </tr>
        }
    </table>
    @* <a asp-controller="Home" asp-action="EditCart">Ändra varukorg</a> *@
    <div>
        <a asp-controller="Home" asp-action="EditCart">Ändra varukorg</a>
        |
        <a asp-controller="Home" asp-action="PayCart">Betala</a>
    </div>
}
else
{
    <p>Varukorgen är tom</p>    
}

</div>