@using Microsoft.AspNetCore.Routing.Constraints
@using webbhelpuf.Data.Models;
@using webbhelpuf.Shared;
@model webbhelpuf.ViewModels.CustomerViewModel;
@{
    ViewData["Title"] = "Customer Page";
    ViewData["ShopTheme"] = Model.ShopTheme + ".css";
}
<h1>
Verifiera adress och varukorg
</h1>

<div class="row">
  <div class="col-md-4 mb-4">
    <div class="card mb-4">
      <div class="card-header py-3">
        <h5 class="mb-0">Adressat</h5>
      </div>
      <div class="card-body">
          <div class="row">
            <div class="col">
                <p>@Model.CustomerInfo.FirstName @Model.CustomerInfo.LastName</p>
            </div>
          </div>

          <div class="row">
            <div class="col">
              <p>@Model.CustomerInfo.StreetName @Model.CustomerInfo.StreetNo</p>
            </div>
          </div>

          <div class="row">
            <div class="col">
              <p>@Model.CustomerInfo.ZipCode @Model.CustomerInfo.City</p>
            </div>
          </div>

          <div class="d-flex justify-content-center">
            <a asp-controller="Customer" asp-action="Edit" class="btn btn-primary btn-lg btn-block">
              Ändra adress
            </a>
          </div>

      </div>
    </div>
  </div>



  <div class="col-md-4 mb-4">
    <div class="card mb-4">
      <div class="card-header py-3">
        <h5 class="mb-0">Kontaktuppgifter</h5>
      </div>
      <div class="card-body">
          <div class="row">
            <div class="col">
                <p>@Model.CustomerInfo.Email</p>
            </div>
          </div>

          <div class="row">
            <div class="col">
              <p>@Model.CustomerInfo.Phone</p>
            </div>
          </div>

          <div class="d-flex justify-content-center">
            <a asp-controller="Customer" asp-action="Edit" class="btn btn-primary btn-lg btn-block">
              Ändra Kontaktuppgifter
            </a>
          </div>

      </div>
    </div>
  </div>






  <div class="col-md-4 mb-4">
    <div class="card mb-4">
      <div class="card-header py-3">
        <h5 class="mb-0">Sammanställning</h5>
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 pb-0">
            Produkter
            <span>@Model.CartTotal SEK</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            Frakt
            <span>@Model.Shop.Settings.BaseShippingPrice SEK</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 mb-3">
            <div>
              <strong>Summa</strong>
              <strong>
                <p class="mb-0">(inklusive moms)</p>
              </strong>
            </div>
            @{int summan = Model.CartTotal + Model.Shop.Settings.BaseShippingPrice;}
            <span><strong>@summan SEK</strong></span>
          </li>
        </ul>
        <div class="d-flex justify-content-center">
          <form asp-controller="Customer" asp-action="CreateOrder">
          <input type="hidden" name="shopid" value="@Model.Shop.Id" />
          <input type="hidden" name="customerid" value="@Model.Customer.Id" />
          <input type="hidden" name="cartid" value="@Model.Cart.Id" />
          <input type="submit" class="btn btn-primary btn-lg btn-block" value="Betala" />
          @* gör denna till ett formulär som skickar med cartid och customerid *@
          @* basera INTE köpet på dessa. kolla att sessions-id:na för cart o Customer *@
          @* är samma som från detta formuläret *@
          @* qr-kod och betalknapp på vyn *@
          </form>
        </div>
      </div>
    </div>
  </div>
</div>