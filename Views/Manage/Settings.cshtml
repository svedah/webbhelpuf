@using webbhelpuf.Shared
@model webbhelpuf.ViewModels.ManageViewModel
@{
    ViewData["Title"] = "Administrationssida";
    ViewData["ShopTheme"] = Model.ShopTheme + ".css";
}
<h1>Inställningssida</h1>

<fieldset class="form-group border p-3">
<legend class="w-auto">Inställningar</legend>
<form asp-controller="Manage" asp-action="Settings" enctype="multipart/form-data">

    <div class="form-group">
        <label for="settings_title">Företagsnamn</label>
        <input class="form-control" id="settings_title" type="text" name="title" value="@Model.Shop.Settings.Title" />
    </div>

    <div class="form-group">
        <label for="settings_swish">Swishnummer</label>
        <input class="form-control" id="settings_swish" type="text" name="swishnumber" value="@Model.Shop.Settings.SwishNumber" />
    </div>

    <div class="form-group">
        <label for="settings_baseshippingprice">Grundpris frakt</label>
        <input class="form-control" id="settings_baseshippingprice" type="number" min="0" max="1000" name="baseshippingprice" value="@Model.Shop.Settings.BaseShippingPrice" />
    </div>

    <div class="form-group">
        <label for="settings_description">Beskrivning av företag</label>
        <textarea class="form-control" id="settings_description" rows="10" cols="20" name="description" value="@Model.Shop.Settings.Description"></textarea>
    </div>

    <div class="form-group">
        <label for="settings_layout">Utseende</label>
        <select class="form-control" id="settings_layout" name="layout">
            <option value="" selected disabled>Välj Layout</option>
            <option value="standard">Standard</option>
            <option value="layout1">Utseende 1</option>
            <option value="layout2">Utseende 2</option>
            <option value="layout3">Utseende 3</option>
        </select>
    </div>

    <div class="form-group">
        <label for="settings_theme">Färgtema</label>
        <select class="form-control" id="settings_theme" name="theme">
            <option value="" selected disabled>Välj Tema</option>
            <option value="standard">Standard</option>
            <option value="theme1">Färgtema 1</option>
            <option value="theme2">Färgtema 2</option>
            <option value="theme3">Färgtema 3</option>
        </select>
    </div>

    <div class="form-group">
        <label for="settings_logo">Ladda upp logo</label>
        <input class="form-control-file" id="settings_logo" type="file" name="logoimage" accept="image/*" />
    </div>

    <div class="form-group">
        <img src="/img/logo/@Model.Shop.Settings.LogoImage.Filename" 
            style="max-width: 100px;"
        />
    </div>

    <div class="form-group">
        <input type="hidden" name="id" value="@Model.Shop.Settings.Id" />
        <input class="form-control" type="submit" value="Uppdatera Inställningar" />
    </div>

</form>
</fieldset>

<fieldset class="form-group border p-3">
<legend>Kontaktinformation</legend>
    <form asp-controller="Manage" asp-action="ContactInfo">
        <div class="form-group">
            <label for="contactinfo_email">E-post</label>
            <input class="form-control" id="contactinfo_email" name="email" type="email" value="@Model.Shop.Settings.ContactInfo.Email" />
        </div>
        <div class="form-group">
            <label for="contactinfo_phone">Mobilnummer</label>
            <input class="form-control" id="contactinfo_phone" name="mobilenumber" type="text" value="@Model.Shop.Settings.ContactInfo.MobileNumber" />
        </div>
        <div class="form-group">
            <input type="hidden" name="id" value="@Model.Shop.Settings.ContactInfo.Id" />
            <input class="form-control" type="submit" value="Uppdatera Kontaktinformation" />
        </div>
    </form>
</fieldset>

<fieldset class="form-group border p-3">
<legend>Länkar till Sociala Medier</legend>
<form asp-controller="Manage" asp-action="SocialMedia">
    <div class="form-group">
        <label for="socialmedia_facebook">Facebook</label>
        <input class="form-control" type="text" id="socialmedia_facebook" name="facebook" value="@Model.Shop.Settings.ContactInfo.SocialMedias.Facebook" />
    </div>
    <div class="form-group">
        <label for="socialmedia_instagram">Instagram</label>
        <input class="form-control" type="text" id="socialmedia_instagram" name="instagram" value="@Model.Shop.Settings.ContactInfo.SocialMedias.Instagram" />
    </div>
    <div class="form-group">
        <label for="socialmedia_linkedin">LinkedIn</label>
        <input class="form-control" type="text" id="socialmedia_linkedin" name="linkedin" value="@Model.Shop.Settings.ContactInfo.SocialMedias.LinkedIn" />
    </div class="form-group">
        <label for="socialmedia_tiktok">TikTok</label>
        <input class="form-control" type="text" id="socialmedia_tiktok" name="tiktok" value="@Model.Shop.Settings.ContactInfo.SocialMedias.TikTok" />
    <div class="form-group">
        <label for="socialmedia_youtube">YouTube</label>
        <input class="form-control" type="text" id="socialmedia_youtube" name="youtube" value="@Model.Shop.Settings.ContactInfo.SocialMedias.YouTube" />
    </div>
    <div class="form-group">
        <input type="hidden" name="id" value="@Model.Shop.Settings.ContactInfo.SocialMedias.Id" />
        <input class="form-control" type="submit" value="Uppdatera Sociala Medier" />
    </div>
</form>
</fieldset>
