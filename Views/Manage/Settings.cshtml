@using webbhelpuf.Shared
@model webbhelpuf.ViewModels.ManageViewModel
@{
    ViewData["Title"] = "Administrationssida";
    ViewData["ShopTheme"] = Model.ShopTheme + ".css";
}
<h1>Inställningssida</h1>

<fieldset>
<Legend>Inställningar</Legend>
<form asp-controller="Manage" asp-action="Settings">

    <div>
        <label for="settings_title">Företagsnamn</label>
        <input id="settings_title" type="text" name="title" value="@Model.Shop.Settings.Title" />
    </div>

    <div>
        <label for="settings_swish">Swishnummer</label>
        <input id="settings_swish" type="text" name="swishnumber" value="@Model.Shop.Settings.SwishNumber" />
    </div>

    <div>
        <label for="settings_baseshippingprice"></label>
        <input id="settings_baseshippingprice" type="number" min="0" max="1000" name="baseshippingprice" value="@Model.Shop.Settings.BaseShippingPrice" />
    </div>

    <div>
        <label for="settings_description"></label>
        <textarea id="settings_description" rows="10" cols="20" name="description" value="@Model.Shop.Settings.Description"></textarea>
    </div>

    <div>
        <label for="settings_layout">Utseende</label>
        <select id="settings_layout" name="layout">
            <option value="" selected disabled>Välj Layout</option>
            <option value="standard">Standard</option>
            <option value="layout1">Utseende 1</option>
            <option value="layout2">Utseende 2</option>
            <option value="layout3">Utseende 3</option>
        </select>
    </div>

    <div>
        <label for="settings_theme">Färgtema</label>
        <select id="settings_theme" name="theme">
            <option value="" selected disabled>Välj Tema</option>
            <option value="standard">Standard</option>
            <option value="theme1">Färgtema 1</option>
            <option value="theme2">Färgtema 2</option>
            <option value="theme3">Färgtema 3</option>
        </select>
    </div>
    <div>
        <label for="settings_logo">Ladda upp logo</label>
        <input id="settings_logo" type="file" name="logoimage" />
    </div>
    <div>
        <input type="hidden" name="id" value="@Model.Shop.Settings.Id" />
        <input type="submit" value="Uppdatera Inställningar" />
    </div>

</form>
</fieldset>

<fieldset>
<legend>Kontaktinformation</legend>
    <form asp-controller="Manage" asp-action="ContactInfo">
        <div>
            <label for="contactinfo_email">E-post</label>
            <input id="contactinfo_email" name="email" type="email" value="@Model.Shop.Settings.ContactInfo.Email" />
        </div>
        <div>
            <label for="contactinfo_phone">Mobilnummer</label>
            <input id="contactinfo_phone" name="mobilenumber" type="text" value="@Model.Shop.Settings.ContactInfo.MobileNumber" />
        </div>
        <div>
            <input type="hidden" name="id" value="@Model.Shop.Settings.ContactInfo.Id" />
            <input type="submit" value="Uppdatera Kontaktinformation" />
        </div>
    </form>
</fieldset>

<fieldset>
<legend>Länkar till Sociala Medier</legend>
<form asp-controller="Manage" asp-action="SocialMedia">
    <div>
        <label for="socialmedia_facebook">Facebook</label>
        <input type="text" id="socialmedia_facebook" name="facebook" value="@Model.Shop.Settings.ContactInfo.SocialMedias.Facebook" />
    </div>
    <div>
        <label for="socialmedia_instagram">Instagram</label>
        <input type="text" id="socialmedia_instagram" name="instagram" value="@Model.Shop.Settings.ContactInfo.SocialMedias.Instagram" />
    </div>
    <div>
        <label for="socialmedia_linkedin">LinkedIn</label>
        <input type="text" id="socialmedia_linkedin" name="linkedin" value="@Model.Shop.Settings.ContactInfo.SocialMedias.LinkedIn" />
    </div>
        <label for="socialmedia_tiktok">TikTok</label>
        <input type="text" id="socialmedia_tiktok" name="tiktok" value="@Model.Shop.Settings.ContactInfo.SocialMedias.TikTok" />
    <div>
        <label for="socialmedia_youtube">YouTube</label>
        <input type="text" id="socialmedia_youtube" name="youtube" value="@Model.Shop.Settings.ContactInfo.SocialMedias.YouTube" />
    </div>
    <div>
        <input type="hidden" name="id" value="@Model.Shop.Settings.ContactInfo.SocialMedias.Id" />
        <input type="submit" value="Uppdatera Sociala Medier" />
    </div>
</form>
</fieldset>
